[Unit]
Description=Gatherly orphan-image sweep scheduler
Documentation=file:///srv/gatherly/README.md

# These two live in [Unit], not [Service]: systemd 229 moved them there, and the
# [Service] copies are ignored, which would make a crashing scheduler restart
# forever.
StartLimitIntervalSec=300
StartLimitBurst=5

# The scheduler only needs the app to be reachable; it retries on its own if it
# starts first, but waiting for the network avoids a noisy first attempt.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gatherly
Group=gatherly
WorkingDirectory=/srv/gatherly

# APP_URL, CRON_SECRET and SWEEP_INTERVAL_MINUTES come from here. Keep the file
# mode 0600 and owned by the service user; it also holds DATABASE_URL.
EnvironmentFile=/srv/gatherly/.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# node directly, never through npm: with npm in between, systemd signals the
# wrapper and node can outlive the unit or be killed abruptly on stop. /usr/bin/
# env execs node in place, so the main PID is the scheduler. Change the path if
# node lives elsewhere (nvm installs under /usr/local/bin or a home directory).
ExecStart=/usr/bin/env node scripts/scheduler.mjs

Restart=always
RestartSec=10
TimeoutStopSec=15
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gatherly-scheduler

# The job only needs to talk to the app and Postgres; it writes nothing locally.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
