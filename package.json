{
  "name": "gatherly-invitations",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "node scripts/db-local-up.mjs",
    "dev": "next dev -p 3210",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "check": "tsc --noEmit && eslint . && vitest run",
    "build": "next build",
    "start": "next start -p 3210",
    "db:local:start": ".localdb/pgsql/bin/pg_ctl.exe -D .localdb/data -o \"-p 5544 -c listen_addresses=127.0.0.1\" -l .localdb/postgres.log start",
    "db:local:stop": ".localdb/pgsql/bin/pg_ctl.exe -D .localdb/data stop",
    "db:use:local": "node scripts/db-use.mjs local",
    "db:use:neon": "node scripts/db-use.mjs neon",
    "db:export": "node --env-file-if-exists=.env scripts/db-export.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/db-import.mjs",
    "db:import-users": "node --env-file-if-exists=.env scripts/db-import-users.mjs",
    "db:sweep-images": "node --env-file-if-exists=.env scripts/db-sweep-images.mjs",
    "db:shrink-images": "node --env-file-if-exists=.env scripts/db-shrink-images.mjs",
    "scheduler": "node --env-file-if-exists=.env scripts/scheduler.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "jsqr": "^1.4.0",
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
